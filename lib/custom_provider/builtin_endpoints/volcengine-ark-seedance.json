{
  "kind": "declarative",
  "schema_version": "1.0.0",
  "meta": {
    "name": "火山方舟 (Seedance)",
    "author": "ArcReel",
    "version": "1.0.0",
    "homepage": "https://www.volcengine.com/product/ark",
    "hints": {
      "base_url": "https://ark.cn-beijing.volces.com/api/v3",
      "suggested_models": [
        {"id": "doubao-seedance-2-0-260128"},
        {"id": "doubao-seedance-2-0-fast-260128"},
        {"id": "doubao-seedance-1-5-pro-251215"}
      ]
    }
  },
  "auth": {"headers": {"Authorization": "Bearer {{ api_key }}"}},
  "inputs": {
    "first_frame": {"source": "start_image", "encoding": "data_uri"},
    "last_frame": {"source": "end_image", "encoding": "data_uri"},
    "refs": {"source": "reference_images", "encoding": "data_uri"},
    "ref_audio": {"source": "reference_audio_files", "encoding": "data_uri"}
  },
  "defaults": {"resolution": "720p"},
  "submit": {
    "method": "POST",
    "url": "{{ base_url }}/contents/generations/tasks",
    "body": {
      "model": "{{ model }}",
      "content": [
        {"type": "text", "text": "{{ prompt }}"},
        {
          "$when": "first_frame",
          "type": "image_url",
          "image_url": {"url": "{{ inputs.first_frame }}"},
          "role": "first_frame"
        },
        {
          "$when": "last_frame",
          "type": "image_url",
          "image_url": {"url": "{{ inputs.last_frame }}"},
          "role": "last_frame"
        },
        {
          "$each": {
            "in": "inputs.refs",
            "as": "ref",
            "item": {
              "type": "image_url",
              "image_url": {"url": "{{ ref }}"},
              "role": "reference_image"
            }
          }
        },
        {
          "$each": {
            "in": "inputs.ref_audio",
            "as": "audio",
            "item": {
              "type": "audio_url",
              "audio_url": {"url": "{{ audio }}"},
              "role": "reference_audio"
            }
          }
        }
      ],
      "ratio": "{{ aspect_ratio }}",
      "duration": "{{ duration }}",
      "resolution": "{{ resolution }}",
      "generate_audio": "{{ generate_audio }}",
      "watermark": false
    },
    "extract": {
      "task_id": ["$.id"],
      "error": ["$.error.message", "$.error", "$.message"]
    }
  },
  "poll": {
    "method": "GET",
    "url": "{{ base_url }}/contents/generations/tasks/{{ task_id }}",
    "expire_on_404": true,
    "extract": {
      "status": ["$.status"],
      "video_url": ["$.content.video_url"],
      "error": ["$.error.message", "$.error", "$.message"]
    }
  },
  "status_map": {
    "queued": "queued",
    "pending": "queued",
    "running": "running",
    "processing": "running",
    "succeeded": "succeeded",
    "success": "succeeded",
    "failed": "failed",
    "expired": "failed",
    "cancelled": "failed",
    "canceled": "failed"
  },
  "capabilities": {
    "first_frame": true,
    "last_frame": true,
    "max_reference_images": 9,
    "reference_audio_mode": "direct",
    "max_reference_audio_count": 3,
    "max_reference_audio_total_seconds": 15,
    "audio_track": "controllable"
  }
}
